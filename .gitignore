.foreman/
.foreman-tasks/
.foreman-worktrees/

# Graphify generated output
**/graphify-out/

# Archive (원본 데이터, 일회성 스크립트)
archive/
.gstack/

# libhangul (LGPL 2.1) — repo에 담지 않고 스크립트가 내려받아 동적 링크한다
apps/macos-ime/vendor/
apps/macos-ime/Sources/CHangul/include/

# 윈도우 입력기 빌드 산출물
apps/windows-ime/target/
apps/windows-ime/build/

# 채점 이력 — 최신(suggestion-latest.json)만 남기고 시각별 사본은 로컬에만 둔다
data/eval/suggestion-2*.json

# 골든셋 원본 덤프와 생성물 — 재생성 가능하므로 커밋하지 않는다
data/golden-src/
data/eval/golden-*.jsonl

# 저장소 밖을 가리키는 개인 문서 — 공개 트리에도 들어가지 않는다
CLAUDE.local.md
AGENTS.local.md
