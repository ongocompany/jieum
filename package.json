{
  "name": "jieum",
  "version": "0.0.1",
  "private": true,
  "description": "지음 — 문맥 인식형 한자입력기 (Context-aware Hanja IME)",
  "scripts": {
    "dev": "pnpm --filter @jieum/chrome-extension dev",
    "build": "pnpm --filter @jieum/core build && pnpm --filter @jieum/browser build && pnpm --filter @jieum/sdk build",
    "build:sdk": "pnpm --filter @jieum/core build && pnpm --filter @jieum/browser build && pnpm --filter @jieum/sdk build",
    "build:dict": "pnpm --filter @jieum/dict-builder build:dict",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r run typecheck"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.69.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "tar@<7.5.7": ">=7.5.7",
      "tar@<=7.5.2": ">=7.5.3",
      "tar@<7.5.8": ">=7.5.8",
      "tar@<=7.5.9": ">=7.5.10",
      "tar@<=7.5.10": ">=7.5.11",
      "tar@<=7.5.3": ">=7.5.4",
      "uuid@<11.1.1": ">=11.1.1",
      "shell-quote@>=1.1.0 <=1.8.3": ">=1.8.4",
      "tmp@<0.2.6": ">=0.2.6",
      "tar@<=7.5.15": ">=7.5.16",
      "adm-zip@<0.6.0": ">=0.6.0",
      "tar@<=7.5.17": ">=7.5.18",
      "tar@<=7.5.18": ">=7.5.19",
      "tar@<=7.5.16": ">=7.5.17",
      "shell-quote@<=1.8.4": ">=1.9.0",
      "tar@<=7.5.20": ">=7.5.21"
    }
  },
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=10"
  }
}
