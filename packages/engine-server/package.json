{
  "name": "@jieum/engine-server",
  "version": "0.0.1",
  "private": true,
  "description": "지음 엔진 서버 — 플랫폼 입력기 셸이 로컬 소켓으로 붙는 변환 엔진",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "tsx src/main.ts",
    "bench": "tsx src/bench.ts",
    "compile": "bun build --compile src/main.ts --outfile bin/jieum-engine"
  },
  "dependencies": {
    "@jieum/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
