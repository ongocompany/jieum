{
  "name": "@jieum/browser",
  "version": "0.0.1",
  "private": true,
  "description": "지음 브라우저 공통 모듈 — 입력 감지, 후보 팝업, 텍스트 치환",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
