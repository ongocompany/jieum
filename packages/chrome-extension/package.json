{
  "name": "@jieum/chrome-extension",
  "version": "0.0.1",
  "private": true,
  "description": "지음입력기 Chrome 확장",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@jieum/browser": "workspace:*",
    "@jieum/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "wxt": "^0.19.29"
  }
}
